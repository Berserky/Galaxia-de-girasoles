<?xml version="1.0" encoding="utf-8"?><ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/galaxy_bg" android:fillViewport="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NUESTRA GALAXIA" android:textColor="@color/galaxy_accent" android:textSize="13sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Compañero Android" android:textColor="@color/galaxy_text" android:textSize="30sp" android:textStyle="bold"/><TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:padding="16dp" android:background="@color/galaxy_surface" android:textColor="@color/galaxy_text" android:text="Estado"/>
<LinearLayout android:id="@+id/pairPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="20dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Vincular este teléfono" android:textColor="@color/galaxy_text" android:textSize="20sp" android:textStyle="bold"/><EditText android:id="@+id/pairCode" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Código de vinculación" android:inputType="textCapCharacters" android:textColor="@color/galaxy_text" android:textColorHint="@color/galaxy_muted"/><Button android:id="@+id/pairButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Vincular teléfono"/></LinearLayout>
<Button android:id="@+id/startButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Comenzar a compartir en segundo plano"/><Button android:id="@+id/stopButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Detener ubicación"/><Button android:id="@+id/backgroundButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Revisar permisos de segundo plano"/><Button android:id="@+id/openGalaxyButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Abrir Nuestra Galaxia"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="Actualizaciones" android:textColor="@color/galaxy_text" android:textSize="20sp" android:textStyle="bold"/><TextView android:id="@+id/updateStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="La app comprueba actualizaciones automáticamente." android:textColor="@color/galaxy_muted"/><ProgressBar android:id="@+id/updateProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:max="100" android:visibility="gone"/><Button android:id="@+id/updateButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Buscar actualización"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Las actualizaciones se descargan y verifican dentro de la app. Android solo solicita la autorización final de instalación." android:textColor="@color/galaxy_muted" android:textSize="13sp"/></LinearLayout></ScrollView>