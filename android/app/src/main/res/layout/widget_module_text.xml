<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="wrap_content"
 android:orientation="vertical" android:paddingTop="3dp" android:paddingBottom="3dp">
 <TextView android:id="@+id/widgetModuleLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
  android:textColor="@color/galaxy_accent" android:textSize="11sp" android:textStyle="bold" android:maxLines="1"/>
 <TextView android:id="@+id/widgetModuleValue" android:layout_width="match_parent" android:layout_height="wrap_content"
  android:textColor="@color/galaxy_text" android:textSize="11sp" android:maxLines="2" android:ellipsize="end"/>
</LinearLayout>