<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widgetRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/galaxy_hero">
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="NUESTRA GALAXIA · PARA DOS" android:textColor="@color/galaxy_accent" android:textSize="10sp" android:letterSpacing="0.08"/>
 <TextView android:id="@+id/widgetNames" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/galaxy_text" android:textSize="20sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
 <ImageView android:id="@+id/widgetPhoto" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" android:scaleType="centerCrop" android:contentDescription="Foto elegida de nuestro álbum" android:visibility="gone"/>
 <TextView android:id="@+id/widgetDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/galaxy_muted" android:textSize="12sp" android:maxLines="2" android:ellipsize="end"/>
 <Button android:id="@+id/widgetHug" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:background="@drawable/galaxy_button_primary" android:textColor="@color/galaxy_on_accent" android:text="Enviar abrazo" android:textSize="13sp" android:textAllCaps="false" android:drawableStart="@drawable/ic_heart_lucide" android:drawablePadding="8dp"/>
 <TextView android:id="@+id/widgetFeedback" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="10sp" android:textColor="@color/galaxy_muted" android:maxLines="2" android:visibility="gone"/>
</LinearLayout>
