<resources>
 <style name="Theme.NuestraGalaxia" parent="android:style/Theme.Material.Light.NoActionBar">
  <item name="android:fontFamily">sans-serif</item><item name="android:windowLightStatusBar">true</item>
  <item name="android:navigationBarColor">@color/galaxy_bg</item><item name="android:statusBarColor">@color/galaxy_bg</item><item name="android:colorAccent">@color/galaxy_accent</item><item name="android:windowBackground">@color/galaxy_bg</item>
 </style>
 <style name="GalaxyButton"><item name="android:minHeight">52dp</item><item name="android:textSize">14sp</item><item name="android:textAllCaps">false</item><item name="android:fontFamily">sans-serif-medium</item><item name="android:padding">14dp</item><item name="android:background">@drawable/galaxy_button_primary</item><item name="android:backgroundTint">@null</item><item name="android:textColor">@color/galaxy_button_text</item><item name="android:stateListAnimator">@null</item></style>
 <style name="GalaxyButton.Secondary" parent="GalaxyButton"><item name="android:background">@drawable/galaxy_button_secondary</item><item name="android:textColor">@color/galaxy_button_secondary_text</item></style>
 <style name="GalaxyHeading"><item name="android:textSize">21sp</item><item name="android:textColor">@color/galaxy_text</item><item name="android:fontFamily">sans-serif-medium</item><item name="android:lineSpacingExtra">3dp</item></style>
 <style name="GalaxyBody"><item name="android:textSize">14sp</item><item name="android:textColor">@color/galaxy_muted</item><item name="android:lineSpacingExtra">5dp</item></style>
 <style name="GalaxyEyebrow"><item name="android:textSize">11sp</item><item name="android:textColor">@color/galaxy_accent</item><item name="android:fontFamily">sans-serif-medium</item><item name="android:letterSpacing">0.12</item></style>
</resources>
